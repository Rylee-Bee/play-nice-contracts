{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "play-nice/references-v1",
  "title": "Play-Nice Participant References",
  "description": "Stable things future sessions should know exist: frame IDs, export paths, document anchors. External IDs are useful; secrets are not. Every reference carries a canonicality status from the shared vocabulary.",
  "type": "object",
  "required": ["schema", "participant", "references"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "play-nice/references-v1" },
    "participant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
    "canonical": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 200 } },
      "description": "Pointers to the project's canonical anchors, e.g. current_design_pointer.path."
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
          "type": { "enum": ["frame", "file", "export", "document", "component", "endpoint", "asset"] },
          "external_id": { "type": ["string", "null"], "maxLength": 200, "description": "External identifier (frame ID, node ID). Never a credential." },
          "export": { "type": ["string", "null"], "maxLength": 200, "description": "Local export path (e.g. .project/design/exports/today.png)." },
          "status": {
            "enum": ["canonical", "reference", "observed", "generated", "historical", "superseded", "stale", "unknown"],
            "description": "Canonicality state — not everything is equally authoritative."
          },
          "provenance": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "participant": { "type": ["string", "null"], "maxLength": 64 },
              "source": { "type": ["string", "null"], "maxLength": 120 },
              "observed_at": { "type": ["string", "null"] },
              "method": { "type": ["string", "null"], "maxLength": 60 },
              "canonical_status": { "type": ["string", "null"], "maxLength": 40 }
            }
          }
        }
      }
    }
  }
}