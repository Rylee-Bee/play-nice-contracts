{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "play-nice/participant-capabilities-v1",
  "title": "Play-Nice Participant Capabilities",
  "description": "What a participant can actually help with — real discovered capabilities only; never invented to populate the file. Limitations recorded alongside. Machine-parseable without any Markdown companion.",
  "type": "object",
  "required": ["schema", "participant", "capabilities", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "play-nice/participant-capabilities-v1" },
    "participant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
          "description": { "type": "string", "minLength": 8, "maxLength": 300 },
          "inputs": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
          "outputs": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8, "maxLength": 300 },
      "description": "At least one honest limitation is required — every participant has one."
    }
  }
}