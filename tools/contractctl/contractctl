#!/usr/bin/env python3
"""contractctl launcher — stdlib-only, no installer by design.

This shim makes `./tools/contractctl/contractctl <cmd>` work from a library
checkout (and `$PLAY_NICE_LIBRARY/tools/contractctl/contractctl <cmd>` for
consumers) without changing how the tool is found: it resolves its own path
and execs the real contractctl.py next to it. There is still nothing to
install and nothing beyond the Python standard library is required.
"""

import os
import sys
from pathlib import Path

target = Path(__file__).resolve().parent / "contractctl.py"
os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])
